# Port configuration for the Express server
PORT=5000

# MongoDB Connection URI (e.g. MongoDB Atlas Connection String)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Frontend Client URL & Allowed CORS Origins (Comma-separated list)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Node environment setting (development / production)
NODE_ENV=development

# Comma-separated list of email addresses that get the 'admin' role
# automatically the first time they register via POST /api/auth/register.
# This is the only way to provision an admin account — set this before the
# intended admin signs up, then leave it empty (or remove the address) so
# no one else can self-elevate later.
# ADMIN_BOOTSTRAP_EMAILS was removed in SaaS Phase 2 (ADR-0009). If it is set,
# the server refuses to start. Create the first operator with:
#   npm run seed:platform-admin -- --email you@example.com --name "Your Name"

# Mail. Production requires smtp; development defaults to `log` (subjects only),
# tests use an in-memory transport.
# MAIL_TRANSPORT=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=VendorConnect <no-reply@example.com>
# MAIL_DEBUG_BODY=false

# Clerk Authentication credentials (Connected in Phase 7)
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_secret_here

# SAP Integration Mode (true = mock data simulation, false = live RFC connections)
SAP_MOCK_MODE=true

# GSTIN/PAN Verification Mode (true = mock validation, false = live third-party API)
GSTIN_PAN_VERIFY_MOCK_MODE=true
GSTIN_PAN_VERIFY_API_URL=https://api.example-kyc-provider.com/v1/verify
GSTIN_PAN_VERIFY_API_KEY=your_api_key_here

# Structured Winston logging level (error, warn, info, debug)
LOG_LEVEL=info

# Upload parameters
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
